[Unit]
Description=Publish SJSeed dependency health metrics
After=network-online.target amazon-cloudwatch-agent.service docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=nobody
Group=nogroup
ExecStart=/usr/bin/python3 /usr/local/lib/sjseed-monitoring/health_probe.py --url http://localhost:8000/health
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6

